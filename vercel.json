{
  "version": 2,
  "functions": {
    "api/index.py": {
      "includeFiles": "{templates/**,static/**,models/**,models_saved/**,pipeline/**,vajrasense/**}"
    }
  },
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/static/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.py"
    }
  ]
}
